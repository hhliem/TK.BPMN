{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: Run API Host",
      "type": "shell",
      "command": "dotnet run --project src/Host/EnterpriseBpm.ApiHost/EnterpriseBpm.ApiHost.csproj",
      "isBackground": true,
      "problemMatcher": "$msCompile",
      "presentation": {
        "group": "backend",
        "panel": "new"
      }
    },
    {
      "label": "Frontend: Run Vite Dev",
      "type": "shell",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "command": "npm run dev",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "frontend",
        "panel": "new"
      }
    },
    {
      "label": "Run Fullstack (Backend + Frontend)",
      "dependsOn": [
        "Backend: Run API Host",
        "Frontend: Run Vite Dev"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
